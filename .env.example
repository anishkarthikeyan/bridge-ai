# Copy to .env and fill in. Every value here is read by app/infrastructure/config.py —
# nothing in the app reads os.environ directly.

# --- App ---------------------------------------------------------------------
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------
POSTGRES_USER=bridge_ai
POSTGRES_PASSWORD=bridge_ai
POSTGRES_DB=bridge_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bridge_ai:bridge_ai@localhost:5432/bridge_ai

# --- Featherless (OpenAI-compatible LLM) ---------------------------------------
# Consumed by app/integrations/llm/featherless_client.py — scoped to the four LLM tasks only
# (intent extraction, entity extraction, topic classification, message generation).
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2
# Featherless's recommended attribution headers — both optional.
FEATHERLESS_HTTP_REFERER=
FEATHERLESS_X_TITLE=Bridge AI

# --- LLM request tuning ----------------------------------------------------------
# Shared across all Featherless-backed LLM calls.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Bounded exponential backoff for transient failures (429/5xx/timeouts) only — malformed
# model output is never retried.
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.0

# --- Caspian SDK (Phase 6.6) ------------------------------------------------------
# Consumed by app/integrations/real_caspian_client.py, via app/infrastructure/di_container.py.
# Blank CASPIAN_API_KEY means production falls back to LocalCaspianClient (same behavior
# tests use) rather than failing startup — fill it in to use the real caspian-sdk.
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
CASPIAN_WORKSPACE_ID=
# Optional readable mailbox name (bridge-ai -> bridge-ai@agents.trycaspianai.com); blank lets
# Caspian assign one.
CASPIAN_EMAIL_USERNAME=
# How often the inbound poller drains pending Caspian events (app/infrastructure/caspian_poller.py).
CASPIAN_INBOUND_POLL_INTERVAL_SECONDS=5

# --- Channels ---------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN also connects the real Telegram channel via caspian_sdk's
# connect_telegram() — get one from @BotFather.
TELEGRAM_BOT_TOKEN=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# --- Follow-up scheduler ---------------------------------------------------------
# Consumed by app/infrastructure/scheduler.py — periodic autonomous follow-up sweep.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
