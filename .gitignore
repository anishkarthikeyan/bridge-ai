# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual env / uv
.venv/
uv.lock.bak

# Env — never commit real secrets; .env.example is the tracked template
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / frontend (frontend/ also has its own .gitignore for anything more specific)
node_modules/
frontend/dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Docker
*.pid

# Secrets / credentials — belt and braces alongside the .env rule above
*.pem
*.key
*.crt
credentials.json
